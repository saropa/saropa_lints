#!/bin/sh
# Block British spellings before they land. The publish-time spelling audit
# runs too late (the British spellings are already committed) and used to be
# bypassable, which is why BrE kept reaching pub.dev — see
# bugs/british_english_recurrence_attempts.md. This is the hard,
# non-interactive gate. Enable once per clone: git config core.hooksPath .githooks
#
# Scans only the staged source files via the shared guard
# (scripts/hooks/spelling_guard.py). Non-zero exit blocks the commit.

# Staged Added/Copied/Modified files with scannable extensions only.
files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(dart|py|md|ya?ml)$')

[ -z "$files" ] && exit 0

# Resolve a Python interpreter: prefer the Windows `py -3` launcher, then
# python3, then python. Keeps the hook working across contributor setups.
if command -v py >/dev/null 2>&1; then
  PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  PY=python
fi

# Word-splitting on $files is intentional (one arg per path).
# shellcheck disable=SC2086
$PY scripts/hooks/spelling_guard.py $files
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit blocked: fix the British spelling(s) above, re-stage, and commit again."
  exit "$status"
fi

# ── shipped doc links gate ──
# Catch dead or .pubignore-excluded links in shipped docs before they reach CI.
# Only runs when a shipped doc (.md in doc/ or README.md) is being committed.
doc_files=$(echo "$files" | grep -E '^(doc/|README\.md$|\.pubignore$)')
if [ -n "$doc_files" ]; then
  $PY scripts/check_doc_links_excluded_paths.py
  doc_status=$?
  if [ "$doc_status" -ne 0 ]; then
    echo ""
    echo "Commit blocked: shipped doc(s) have broken or excluded-path links. See above."
    exit 1
  fi
fi

# ── generated index freshness gate ──
# When rule files or migration guides change, regenerate the category map
# and migration pack codes so the drift tests never fail in CI.
rule_files=$(echo "$files" | grep -E '^lib/src/rules/.*_rule.*\.dart$')
guide_files=$(echo "$files" | grep -E '^doc/guides/migration_guides/.*\.md$')
tier_file=$(echo "$files" | grep -E '^lib/src/tiers\.dart$')

if [ -n "$rule_files" ] || [ -n "$tier_file" ]; then
  echo "Pre-commit: regenerating category map (rule/tier files changed)..."
  $PY scripts/gen_category_map.py
  gen_cat_status=$?
  if [ "$gen_cat_status" -ne 0 ]; then
    echo "Commit blocked: gen_category_map.py failed."
    exit 1
  fi
  git add lib/src/scan/rule_category_map.dart
fi

if [ -n "$guide_files" ] || [ -n "$tier_file" ] || [ -n "$rule_files" ]; then
  # Dart may not be on PATH in all contributor setups — skip gracefully.
  if command -v dart >/dev/null 2>&1; then
    echo "Pre-commit: regenerating migration pack codes (guide/rule/tier files changed)..."
    dart run tool/generate_migration_pack_codes.dart
    gen_mig_status=$?
    if [ "$gen_mig_status" -ne 0 ]; then
      echo "Commit blocked: generate_migration_pack_codes.dart failed."
      exit 1
    fi
    git add lib/src/config/rule_pack_migration_codes.dart
  fi
fi

# ── dart fix dry-run gate (exit 2 = dart missing, skip gracefully) ──
$PY scripts/check_dart_fix.py
fix_status=$?
if [ "$fix_status" -eq 1 ]; then
  echo ""
  echo "Commit blocked: fixable dart issues found. Run 'dart fix --apply' and re-stage."
  exit 1
fi

# ── recommended.yaml regression gate (exit 2 = dart missing, skip gracefully) ──
$PY scripts/check_recommended_yaml.py
rec_status=$?
if [ "$rec_status" -eq 1 ]; then
  echo ""
  echo "Commit blocked: recommended.yaml lint regressions found. Add // ignore: with rationale or fix the issue."
  exit 1
fi

exit 0
