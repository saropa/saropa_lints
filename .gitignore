# Dart/Flutter
.dart_tool/
.dart_test_tmp/
.packages
build/

# Generated API documentation
doc/api/

# Log files
*.log

# Temporary/generated files
*.bak
nul
tmp_implemented.txt
temp_output.txt
test_output.txt
dx_full.txt
dx_audit_output.txt
*analyze_output*.txt
*format_output*.txt
*format_errors*.txt

# IDE
.idea/
.agents/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Articles (not part of the package)
articles/
__pycache__/

# Reports (output ignored, but organize script is tracked)
/report/
reports/*
!reports/organize_reports.py # keep the organizer script

# Generated analysis reports under packages (batches, sessions, violations)
packages/saropa_lints_api/reports/

# Generated extension reports (i18n coverage/audit, etc.)
extension/reports/

# Example report output (generated by analysis runs)
example*/reports/

# Resolved-rule test harness scratch fixtures (test/support/resolved_rule_harness.dart
# writes unique temp dirs here so fixtures inherit the example package config;
# each is deleted after use, but a crashed run could leave one behind)
example*/lib/__rule_harness__/

# Example lock files (regenerated by dart pub get)
example*/pubspec.lock

# Sub-package lock files (library re-exports; consumers re-resolve, so committed
# lockfiles only create merge churn without affecting downstream resolution).
# Root pubspec.lock stays tracked — it pins the dev workspace and CI.
packages/*/pubspec.lock

# Credentials / secrets
google-services.json

# Extension changelog (copied from root CHANGELOG.md at publish time; single source of truth)
extension/CHANGELOG.md

# Extension README (copied from root README.md at publish time; single source of truth)
extension/README.md

# Extension i18n machine-translation cache (local; never ship secrets here)
extension/scripts/i18n/.cache/

# Claude, Cursor & AI (exclude all — do not track or index)
.github/copilot-instructions.md
.cursor/
.cursorignore
*.cursorrules
mcps/
agent-transcripts/
AGENTS.md
.claude/
CLAUDE*.md
CODEBASE_INDEX.md

# Generated publish-pipeline reports (regenerated each publish run)
plans/known_issues_review.md

# Saropa Log Capture (index & cache)
.saropa/
*.vsix
/docs/handover
self_check/pubspec.lock
